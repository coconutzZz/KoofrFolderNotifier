{
  "BaseFolder": "",
  "Gmail": {
    "FromAddress": ""
  },
  "ConnectionStrings": {
    "KoofrNotifier": "Data Source=D:\\home\\KoofrFolderNotifier\\KoofrFolderNotifier\\sql\\koofrnotifier.db"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": {
      "Console": {
        "Name": "Console"
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/koofrnotifier-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  }
}
